# Supabase API origin, without /rest/v1. Use your VPS HTTPS domain.
supabase_url=https://your-supabase-domain.example
# Use a publishable key, or the legacy anon JWT on older self-hosted stacks.
# Do not use SERVICE_ROLE_KEY.
supabase_publishable_key=
# Server only: secret key or legacy SERVICE_ROLE_KEY, for checking auth_code.
supabase_secret_key=
